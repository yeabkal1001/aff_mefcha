# Copy to .env.local and fill in. `.env.local` is gitignored; never commit it.
#
# Everything here is compiled into the browser bundle. NEXT_PUBLIC_ is not a
# naming convention, it is a publication: treat every value in this file as
# public. Secrets belong in ../server/.env, which the browser never sees.

# Origin of the API. No trailing slash.
#   Local:  http://localhost:4000  (matches server/.env PORT)
#   Render: https://<your-api-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Clerk's *publishable* key — Dashboard → API Keys. The secret key is the
# server's and stays there.
#
# Left blank, the app runs unauthenticated: middleware.ts waves every route
# through and the sign-in screens render nothing. That is deliberate, so a new
# developer sees the UI before they see a redirect loop. It is not a state you
# can deploy: the API rejects every request without a token.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Canonical origin, for metadataBase, Open Graph and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
