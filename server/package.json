{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "prisma generate && tsc --build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "// db:seed:dist": "What to run inside the deployed image, which has no TypeScript.",
    "db:seed:dist": "node dist/cli/seed.js"
  },
  "// prisma": "The CLI is a runtime dependency, not a build tool. `prisma migrate deploy` runs against the deployed image as a pre-deploy step, so pruning it out would break every deployment after the first.",
  "dependencies": {
    "@clerk/express": "^1.7.42",
    "@google/genai": "^1.35.0",
    "@prisma/client": "^6.3.1",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "helmet": "^8.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.19.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
