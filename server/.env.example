# Copy to .env and fill in. Never commit .env.
# Every provider key is server-side only — none of these belong in the client bundle.

# --- database ---
# Matches docker-compose.yml. `pnpm db:up` from the repo root starts it.
# SQLAlchemy needs the +asyncpg driver in the URL; Alembic reuses this value.
DATABASE_URL="postgresql+asyncpg://coach:coach@localhost:5432/english_coach"

# --- server ---
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# --- providers (see docs/architecture/integrations.md) ---
# TODO: add the keys. Server-side only — none belong in the client bundle. Leave any
# of them blank and the server still starts; the call that needs it fails loudly
# instead.

# Amharic only: translation, and the Amharic audio for the correction line.
# https://platform.addisassistant.com — Addis STT and TTS both cover am/om
# exclusively, so no English passes through this key.
ADDIS_API_KEY=

# The analysing model and (fallback) English coach voice, from Google AI Studio:
# conversation direction, the opportunity counts the authored error tags cannot
# reach on their own, and English TTS when ElevenLabs is not configured.
GEMINI_API_KEY=

# Preferred English STT (Scribe) and English TTS.
# https://elevenlabs.io — word timestamps via timestamps_granularity=word.
ELEVENLABS_API_KEY=
ENGLISH_STT_PROVIDER=elevenlabs

# Optional secondary English STT: whisper-api.com. Free tier: tiny | small | medium.
ENGLISH_STT_API_KEY=
ENGLISH_STT_MODEL_SIZE=tiny

# Stimulus sourcing only, not models — finding and fetching images and scenarios for
# the Stimulus Pool.
EXA_API_KEY=
FIRECRAWL_API_KEY=

# --- demo ---
# Single switch for every prop. See the demo-fidelity skill.
DEMO_MODE=0

# Day Three arrives by clock injection: the scheduler reads this offset instead of
# a hardcoded date, so "try four days instead" still works on stage.
DEMO_CLOCK_OFFSET_HOURS=0
