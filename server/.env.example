# Copy to .env and fill in. Never commit .env.
# Every provider key is server-side only — none of these belong in the client bundle.

# --- database ---
# Matches docker-compose.yml. `pnpm db:up` from the repo root starts it.
# SQLAlchemy needs the +asyncpg driver in the URL; Alembic reuses this value.
DATABASE_URL="postgresql+asyncpg://coach:coach@localhost:5432/english_coach"

# --- server ---
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# --- providers (see docs/architecture/integrations.md) ---
# TODO: add the keys. All four are server-side only — none belong in the client bundle.
# Leave any of them blank and the server still starts; the call that needs it fails
# loudly instead.

# Amharic: translation and Amharic TTS for the correction line. https://addisai.net
ADDIS_API_KEY=

# Speech to text and English text to speech.
# STT uses Scribe v2 with timestamps_granularity="word" — those word timestamps are
# where every delivery metric comes from, so this key gates Confidence and Fluency.
ELEVENLABS_API_KEY=

# The analysing model, from Google AI Studio: conversation direction, and the
# opportunity counts the authored error tags cannot reach on their own.
GEMINI_API_KEY=

# Stimulus sourcing only, not models — finding and fetching images and scenarios for
# the Stimulus Pool.
EXA_API_KEY=
FIRECRAWL_API_KEY=

# --- demo ---
# Single switch for every prop. See the demo-fidelity skill.
DEMO_MODE=0

# Day Three arrives by clock injection: the scheduler reads this offset instead of
# a hardcoded date, so "try four days instead" still works on stage.
DEMO_CLOCK_OFFSET_HOURS=0
