# Copy to .env and fill in. Never commit .env.
# Every provider key is server-side only — none of these belong in the client bundle.

# --- database ---
# Matches docker-compose.yml. `pnpm db:up` starts it.
DATABASE_URL="postgresql://coach:coach@localhost:5432/english_coach?schema=public"

# --- server ---
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# --- providers (see docs/architecture/integrations.md) ---
ADDIS_API_KEY=
WISPR_FLOW_API_KEY=
FAL_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# --- demo ---
# Single switch for every prop. See the demo-fidelity skill.
DEMO_MODE=0
