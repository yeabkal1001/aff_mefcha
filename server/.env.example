# Copy to .env and fill in. `.env` is gitignored; never commit it.
#
# Every value here is validated at startup by src/config/env.ts. A missing or
# malformed one is a crash with the variable named, not a silent default.
#
# Everything in this file is server-side only. None of it belongs in the client
# bundle — the client's own configuration is in ../client/.env.example, and the
# only key that legitimately appears there is Clerk's *publishable* key.

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated. Never a wildcard: the API is credentialed.
CLIENT_ORIGINS=http://localhost:3000

# --- database --------------------------------------------------------------
# Local: matches docker-compose.yml. `pnpm db:up` from the repo root starts it.
DATABASE_URL="postgresql://coach:coach@localhost:55432/english_coach?schema=public"
#
# Render: use the *Internal* Database URL when the service runs inside Render —
# it is faster and never leaves their network. The External URL (the one with a
# region in the hostname, e.g. dpg-xxxx-a.oregon-postgres.render.com) is what
# you need to connect from your laptop, and it requires ?sslmode=require.
# render.yaml wires the internal one automatically via fromDatabase.

DATABASE_STATEMENT_TIMEOUT_MS=8000

# --- authentication --------------------------------------------------------
# Clerk. Dashboard → API Keys. The secret key must never reach the browser.
#
# Copy the publishable key whole. Its suffix is base64 and the server checks
# that it decodes, because Clerk itself only parses the key on the first
# authenticated request — a truncated one would otherwise give you an instance
# that passes its health check and 500s every real request.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Dashboard → Webhooks → your endpoint → Signing Secret. Required in production:
# without it, deletions in Clerk are never reflected here.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- model providers -------------------------------------------------------
# Gemini runs the conversation director and the evaluator.
GEMINI_API_KEY=
GEMINI_DIRECTOR_MODEL=gemini-2.5-flash
GEMINI_EVALUATOR_MODEL=gemini-2.5-pro

# Optional. The browser's own speech synthesis is the default coach voice; this
# is the upgrade for devices whose built-in voices are poor. Leave blank to use
# Web Speech only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional. Web Speech gives a transcript but no word timings. Whisper is the
# upgrade path when a turn is worth the round trip. Leave blank to skip.
WHISPER_API_KEY=
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions

# --- behaviour -------------------------------------------------------------
LOG_LEVEL=debug

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Tighter budget for the endpoints that cost money at a provider.
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=30

SHUTDOWN_GRACE_MS=15000

# Exact number of proxies in front of the service. Render puts one. Too low and
# every client shares the load balancer's IP; too high and a client can spoof
# X-Forwarded-For for a fresh rate-limit bucket per request.
TRUST_PROXY_HOPS=1
